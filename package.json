{
  "name": "postgres-index-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "psql": "docker compose exec db psql -U postgres -d lab",
    "seed": "tsx src/seed.ts",
    "step": "tsx src/step.ts",
    "top": "tsx src/top.ts",
    "bench:writes": "tsx src/bench-writes.ts",
    "cache": "tsx src/cache/load.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
